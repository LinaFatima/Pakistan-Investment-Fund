# Copy to .env and fill in your own values.

# --- Browser (bundled into the public site; the anon key is public by design) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Server only: set these in Vercel -> Settings -> Environment Variables. ---
# --- NEVER prefix with VITE_ (that would publish them in the website) ---
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_SESSION_SECRET=a-random-string-of-at-least-32-characters
CRON_SECRET=a-long-random-string
